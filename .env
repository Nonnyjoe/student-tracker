# =============================================================================
# Student Tracker — runtime configuration
# =============================================================================
# Portal addresses below are Cartesi Rollups v2.2.0 (CREATE2-deterministic).
# They are identical on every EVM chain: local Anvil devnet, testnets, mainnet.
#
# These values are baked into the Cartesi Machine image at build time via
# Dockerfile ARG/ENV.  To override for a custom contract suite, export the
# vars before building:
#
#   export $(grep -v '^#' .env | xargs) && cartesi build
#
# or pass them directly as build-args:
#
#   cartesi build -- --build-arg ERC20_PORTAL_ADDRESS=0x...
# =============================================================================

ERC20_PORTAL_ADDRESS=0xaca6586a0cf05bd831f2501e7b4aea550da6562d
ERC721_PORTAL_ADDRESS=0x9e8851dadb2b77103928518846c4678d48b5e371
ERC1155_PORTAL_ADDRESS=0x18558398dd1a8ce20956287a4da7b76ae7a96662
